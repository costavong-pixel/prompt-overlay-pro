# This is a template. Keep the production environment file outside source
# control (for example, /etc/prompt-overlay-trial/trial.env).
# Selected external HTTPS domain: https://teleprompter-trail.barndai.com
# This is not live until DNS, TLS and reverse proxy are configured.
# OAuth WEB client ID (public identifier, not a client secret) from Google Cloud.
GOOGLE_WEB_CLIENT_ID=

# Docker-free systemd deployment: restrict the listener to loopback. Pick an
# unused port with a live read-only check before enabling the service; 18765 is
# the documented isolated-service example, not a reservation.
HOST=127.0.0.1
PORT=18765
TRIAL_DB_PATH=/var/lib/prompt-overlay-trial/entitlements.sqlite

# Use "internal" only behind the dedicated Nginx route that overwrites
# X-Forwarded-For. Use 0 for a direct loopback-only test.
TRUST_PROXY=internal

# Docker-only host mapping. The Compose project is explicitly named and this
# remains loopback-only when that optional deployment path is used.
TRIAL_HOST_PORT=18765

# No Play Console service account JSON, signing key, database encryption key,
# or account password belongs in this file or this repository.
