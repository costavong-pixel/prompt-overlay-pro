# This is a template. Create server/.env on the VPS (never commit it).
# OAuth WEB client ID (public identifier, not a client secret) from Google Cloud.
GOOGLE_WEB_CLIENT_ID=

# For running Node directly outside Docker: restrict the listener to loopback.
# Docker Compose overrides HOST, PORT and TRIAL_DB_PATH internally.
HOST=127.0.0.1
PORT=8765
TRIAL_DB_PATH=/var/lib/prompt-overlay/entitlements.sqlite

# TRUST_PROXY=0 for Node directly; Docker Compose explicitly uses "internal"
# and requires an Nginx proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0

# No Play Console service account JSON, signing key, database encryption key,
# or account password belongs in this file or this repository.
