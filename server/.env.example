# Publicly visible Web OAuth client ID from Google Cloud (NOT a client secret)
GOOGLE_WEB_CLIENT_ID=
# Bind backend to loopback; terminate HTTPS on your reverse proxy.
HOST=127.0.0.1
PORT=8765
# Must point to writable, persistent storage on the server.
TRIAL_DB_PATH=/var/lib/prompt-overlay/entitlements.sqlite
# Optionally configure reverse-proxy trust ONLY for a known network.
TRUST_PROXY=0
# The production mobile app will not connect until configured.
