# Put these directives inside a TLS-enabled server block for your chosen
# subdomain (for example trial.barndai.com); do not expose this on plain HTTP.
# HTTPS certificates, DNS and an Nginx server block must already exist.
#
# Client IP is SET, rather than APPENDED to user-supplied X-Forwarded-For.
# This works with TRUST_PROXY=internal and loopback/Docker local networking.
location / {
    proxy_pass http://127.0.0.1:8765;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_connect_timeout 5s;
    proxy_read_timeout 20s;
    proxy_send_timeout 20s;
    client_max_body_size 16k;
    add_header Cache-Control "no-store" always;
}
